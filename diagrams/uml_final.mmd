%% PawPal+ — final UML class diagram
%% Reflects the implemented pawpal_system.py (domain model + App service layer).

classDiagram
    direction TB

    class App {
        +List~Owner~ owners
        +List~Pet~ pets
        +List~CareTask~ tasks
        +List~DailyPlan~ plans
        -Dict~str, Owner~ _owners_by_id
        -Dict~str, Pet~ _pets_by_id
        -Dict~str, CareTask~ _tasks_by_id
        -Dict~str, List~CareTask~~ _tasks_by_pet_id
        -Dict~str, DailyPlan~ _plans_by_key
        +save_owner(owner)
        +delete_owner(owner_id)
        +load_owner(owner_id) Owner
        +save_pet(pet)
        +delete_pet(pet_id)
        +load_pet(pet_id) Pet
        +save_task(task)
        +delete_task(task_id)
        +load_tasks(pet_id) List~CareTask~
        +load_task(task_id) CareTask
        +save_plan(plan)
        +delete_plan(plan_date, pet_id)
        +load_plan(date, pet_id) DailyPlan
        +build_plan(plan_date, pet_id) DailyPlan
        +build_owner_plan(plan_date, owner_id) List~CareTask~
        +complete_task(plan_date, pet_id, task_id, complete) CareTask
        +filter_tasks(pet_name, completed) List~CareTask~
        +find_conflicts(plan_date, owner_id) List~tuple~
        +conflict_warnings(plan_date, owner_id) List~str~
        +sort_by_time(tasks, priority_tiebreak)$ List~CareTask~
    }

    class Owner {
        +owner_id
        +name
        +contact_info
        +List~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_pet(pet_id) Pet
    }

    class Pet {
        +pet_id
        +owner_id
        +name
        +species
        +breed
        +age
        +Owner owner
        +List~CareTask~ tasks
        +add_task(task)
        +remove_task(task)
        +tasks_by_priority() List~CareTask~
    }

    class CareTask {
        +task_id
        +pet_id
        +description
        +frequency
        +duration_minutes
        +priority
        +preferred_time
        +weekday
        +time_bounds() Optional~tuple~
        +create_next_occurrence(next_day) CareTask
        +is_due_on(when) bool
    }

    class DailyPlan {
        +date
        +pet_id
        +List~CareTask~ tasks
        +Dict~str, bool~ completion_status
        -List~str~ _extra_task_ids
        +task_ids() List~str~
        +add_task(task)
        +overlapping(tasks) List~tuple~
        -_intervals_overlap(a, b)$ bool
        +mark_complete(task_id, complete)
        +is_complete() bool
        +progress() float
    }

    Owner "1" *--> "0..*" Pet : owns
    Pet "1" *--> "0..*" CareTask : has
    DailyPlan "1" *--> "0..*" CareTask : schedules
    App "1" *--> "0..*" Owner : stores
    App "1" *--> "0..*" Pet : stores
    App "1" *--> "0..*" CareTask : stores
    App "1" *--> "0..*" DailyPlan : stores
