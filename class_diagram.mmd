classDiagram
    direction TB

    class App {
        +List~Owner~ owners
        +List~Pet~ pets
        +List~CareTask~ tasks
        +List~DailyPlan~ plans
        +save_owner(owner)
        +load_owner(owner_id) Owner
        +save_pet(pet)
        +load_pet(pet_id) Pet
        +save_task(task)
        +load_tasks(pet_id) List~CareTask~
        +save_plan(plan)
        +load_plan(date, pet_id) DailyPlan
    }

    class Owner {
        +owner_id
        +name
        +contact_info
        +List~Pet~ pets
        +add_pet(pet)
    }

    class Pet {
        +pet_id
        +owner_id
        +name
        +species
        +breed
        +age
        +Owner owner
        +List~CareTask~ tasks
        +add_task(task)
    }

    class CareTask {
        +task_id
        +pet_id
        +description
        +frequency
        +duration_minutes
        +priority
        +preferred_time
    }

    class DailyPlan {
        +date
        +pet_id
        +List~CareTask~ tasks
        +Dict~str, bool~ completion_status
        +add_task(task)
        +mark_complete(task_id, complete)
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" CareTask : has
    Pet "1" --> "0..*" DailyPlan : has
    DailyPlan "1" --> "0..*" CareTask : schedules
